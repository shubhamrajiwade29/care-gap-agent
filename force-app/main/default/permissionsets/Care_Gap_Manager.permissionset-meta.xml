<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Care Gap Manager</label>
    <description>Grants access to Care Gap records, fields, and Apex classes.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Care_Gap__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Care_Gap__c.Due_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Care_Gap__c.Closed_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <classAccesses><apexClass>CareGapService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>GetPatientCareGaps</apexClass><enabled>true</enabled></classAccesses>
</PermissionSet>
